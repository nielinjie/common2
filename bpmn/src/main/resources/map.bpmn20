						<cf:actionHandle clazz="xyz.nietongxue.common.bpmn.MyAppender" method="append">
							<cf:var name="i" dataType="java.lang.Integer" contextVarName="i" inOutType="param"/>
							<cf:var name="a" dataType="java.lang.String" contextVarName="p" inOutType="param"/>
