			<script>
				<![CDATA[new HashMap<String,String>()]]>
			</script>
		</scriptTask>
		<sequenceFlow name="flow15" id="flow15" sourceRef="newResultMap" targetRef="loop"/>
		<subProcess name="loop" id="loop">
