<definitions xmlns:cf="http://www.compileflow.org/schema/1.0" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="test">
	<process name="test" id="test" isExecutable="true">
		<extensionElements>
