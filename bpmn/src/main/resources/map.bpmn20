			<cf:var name="me" description="me" dataType="java.lang.String" inOutType="param"/>
			<cf:var name="resultMap" description="resultMap" dataType="java.util.HashMap&lt;String,String&gt;" inOutType="return"/>
			<cf:var name="inner_result" description="inner_result" dataType="java.lang.String" inOutType="inner"/>
		</extensionElements>
		<startEvent name="start" id="start"/>
		<sequenceFlow name="flow1" id="flow1" sourceRef="start" targetRef="newResultMap"/>
		<scriptTask name="newResultMap" id="newResultMap" scriptFormat="groovy">
			<extensionElements>
				<cf:var name="resultMap" dataType="java.util.HashMap&lt;String,String&gt;" contextVarName="resultMap" inOutType="return"/>
